{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!**/payload-types.ts",
      "!**/importMap.js",
      "!**/app/(payload)"
    ]
  },
  "javascript": {
    "formatter": {
      "semicolons": "asNeeded"
    }
  },
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": {
            "style": "type"
          }
        },
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "generic"
          }
        },
        "noDefaultExport": "error"
      }
    }
  },
  "overrides": [
    {
      "includes": [
        "apps/**/app/**/*.ts",
        "apps/**/app/**/*.tsx",
        "apps/**/middleware.ts",
        "apps/storybook/.storybook/**/*.ts",
        "apps/storybook/.storybook/**/*.tsx",
        "**/*.stories.ts",
        "**/*.stories.tsx",
        "**/*.config.ts",
        "**/*.config.js",
        "**/*.config.mjs",
        "**/*.config.cjs"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "apps/storybook/.storybook/preview.tsx",
        "packages/ui/src/components/*/index.ts",
        "packages/ui/src/utils/*/index.ts",
        "packages/chrome/src/components/*/index.ts",
        "packages/chrome/src/utils/*/index.ts",
        "packages/payload/src/components/*/index.ts",
        "packages/testing/src/render/index.tsx",
        "packages/testing/src/msw/index.ts",
        "apps/web/src/features/*/components/*/index.ts",
        "apps/web/src/features/*/hooks/*/index.ts",
        "apps/web/src/components/*/index.ts"
      ],
      "linter": {
        "rules": {
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/ui/**",
        "packages/chrome/**",
        "packages/payload/src/components/**",
        "apps/web/src/components/**",
        "apps/web/src/features/*/components/**"
      ],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/utils/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/types/**"],
      "linter": {
        "rules": {
          "style": {
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "requireAscii": true,
                "filenameCases": ["kebab-case"]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/utils/**", "packages/types/**", "packages/env/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@mise/ui",
                      "@mise/ui/**",
                      "@mise/chrome",
                      "@mise/chrome/**",
                      "@mise/payload",
                      "@mise/payload/**",
                      "@mise/auth",
                      "@mise/auth/**"
                    ],
                    "message": "Foundation packages (utils, types, env) must not import from higher layers (ui, chrome, payload, auth). Move shared code down the stack instead."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/ui/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "@mise/chrome",
                      "@mise/chrome/**",
                      "@mise/payload",
                      "@mise/payload/**",
                      "**/apps/**"
                    ],
                    "message": "@mise/ui must not depend on @mise/chrome, @mise/payload, or any app. UI primitives are the lowest visual layer."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/chrome/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["**/apps/**"],
                    "message": "@mise/chrome must not import from any app. Apps depend on chrome, never the other way around."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/recipes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/auth",
                      "~/features/auth/**",
                      "~/features/profile",
                      "~/features/profile/**",
                      "~/features/home",
                      "~/features/home/**",
                      "~/features/saved-recipes",
                      "~/features/saved-recipes/**",
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. Hoist shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/auth/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/recipes",
                      "~/features/recipes/**",
                      "~/features/profile",
                      "~/features/profile/**",
                      "~/features/home",
                      "~/features/home/**",
                      "~/features/saved-recipes",
                      "~/features/saved-recipes/**",
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. Hoist shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/profile/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/recipes",
                      "~/features/recipes/**",
                      "~/features/auth",
                      "~/features/auth/**",
                      "~/features/home",
                      "~/features/home/**",
                      "~/features/saved-recipes",
                      "~/features/saved-recipes/**",
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. Hoist shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/home/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/recipes",
                      "~/features/recipes/**",
                      "~/features/auth",
                      "~/features/auth/**",
                      "~/features/profile",
                      "~/features/profile/**",
                      "~/features/saved-recipes",
                      "~/features/saved-recipes/**",
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. Hoist shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/saved-recipes/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/auth",
                      "~/features/auth/**",
                      "~/features/profile",
                      "~/features/profile/**",
                      "~/features/home",
                      "~/features/home/**",
                      "~/features/collections",
                      "~/features/collections/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. saved-recipes may consume the public RecipeCard from ~/features/recipes (no reverse import). Hoist other shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["apps/web/src/features/collections/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/auth",
                      "~/features/auth/**",
                      "~/features/profile",
                      "~/features/profile/**",
                      "~/features/home",
                      "~/features/home/**",
                      "~/features/saved-recipes",
                      "~/features/saved-recipes/**",
                      "~/app",
                      "~/app/**"
                    ],
                    "message": "Features must not import from other features or from ~/app. collections may consume the public RecipeCard from ~/features/recipes (no reverse import). Hoist other shared code into ~/lib or ~/components."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
